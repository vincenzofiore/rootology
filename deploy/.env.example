# Copy to deploy/.env on the server (chmod 600) and fill in. Never commit the real file.
DOMAIN=rootology.app
ACME_EMAIL=
# A release (for example 0.1.0, see docs/operations.md), or latest for the head of main.
APP_VERSION=latest

POSTGRES_PASSWORD=
NEO4J_PASSWORD=

ROOTOLOGY_BASE_URL=https://rootology.app
ROOTOLOGY_ANTHROPIC_API_KEY=
ROOTOLOGY_TYPESAFE_API_KEY=
ROOTOLOGY_GITHUB_CLIENT_ID=
ROOTOLOGY_GITHUB_CLIENT_SECRET=
ROOTOLOGY_ALLOWED_GITHUB_USERS=
ROOTOLOGY_GOOGLE_CLIENT_ID=
ROOTOLOGY_GOOGLE_CLIENT_SECRET=
# Emails allowed to sign in with Google, comma separated (lower case). Empty: only invited people.
ROOTOLOGY_ALLOWED_GOOGLE_EMAILS=
ROOTOLOGY_GEONAMES_USERNAME=
ROOTOLOGY_PRIVACY_CONTROLLER=
ROOTOLOGY_PRIVACY_CONTACT=

ROOTOLOGY_SMTP_HOST=
ROOTOLOGY_SMTP_PORT=587
ROOTOLOGY_SMTP_USERNAME=
ROOTOLOGY_SMTP_PASSWORD=
ROOTOLOGY_SMTP_AUTH=true
ROOTOLOGY_SMTP_STARTTLS=true
ROOTOLOGY_SMTP_FROM=

# Telegram notifications (#38), optional: without a token the feature is invisible. Use a bot of its own for
# production (@BotFather, /newbot): getUpdates allows one reader per bot, so development and production
# sharing a token would steal each other's updates (HTTP 409).
ROOTOLOGY_TELEGRAM_BOT_TOKEN=
