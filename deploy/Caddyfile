# HTTPS for Rootology (#12): Caddy gets and renews the certificate from Let's Encrypt by itself,
# redirects HTTP to HTTPS and passes requests (websockets included, for Vaadin's push) to the app.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
}

# www.rootology.app has its own certificate and sends everyone to the one address.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
